# Keep this file name and variable server-side. Copy to .env and fill locally.
YOUCAM_API_KEY=
YOUCAM_LIVE_ENABLED=false
PORT=5194
# Successful calls consume your YouCam units. The app never purchases units.
YOUCAM_MAX_TASKS_PER_SESSION=10

# Optional canonical URL for an additional production domain (no trailing slash).
FIRSTFIT_PUBLIC_ORIGIN=
